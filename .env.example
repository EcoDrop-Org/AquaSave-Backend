PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# PostgreSQL connection string (required)
# Local: postgresql://postgres:password@localhost:5432/aquasave
# Render: copy the "External Database URL" from your Render PostgreSQL dashboard
DATABASE_URL=postgresql://postgres:password@localhost:5432/aquasave

# Secret key for signing JWT tokens — use a long random string in production
JWT_SECRET=3a36f09c96097a7c28d353aad4c49618c512d2d8529d6fd665d0015409cd10dfc33612dfbe836528fdc5e44cb6318327


# Optional. If set, Edge endpoints require header: x-edge-api-key
EDGE_API_KEY=

# Weather provider can be replaced later by OpenWeatherMap.
WEATHER_PROVIDER=open-meteo

# Zona horaria para evaluar los horarios de riego programado (HH:MM)
SCHEDULE_TIMEZONE=America/Lima

# Duracion maxima (minutos) de un riego iniciado por horario programado
SCHEDULED_RUN_MINUTES=5
